# Database Configuration
DATABASE_URL=postgresql://cctv_user:cctv_password@localhost:5432/cctv_db
DB_USER=cctv_user
DB_PASSWORD=cctv_password
DB_NAME=cctv_db
DB_HOST=localhost
DB_PORT=5432

# Redis Configuration
REDIS_URL=redis://localhost:6379

# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key

# Application Configuration
APP_ENV=development
DEBUG=True
SECRET_KEY=your-secret-key-change-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,backend

# API Configuration
API_TITLE=CCTV Face Recognition Dashboard
API_VERSION=1.0.0
API_DESCRIPTION=Real-time face recognition and tracking system

# Security
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
CORS_ALLOW_CREDENTIALS=True

# File Upload
MAX_UPLOAD_SIZE=52428800
UPLOAD_DIR=./uploads

# Face Recognition
CONFIDENCE_THRESHOLD=0.9
MAX_FACES_PER_IMAGE=10
FACE_MATCH_THRESHOLD=0.6

# Alert Configuration
ALERT_RETENTION_DAYS=30

# Logging
LOG_LEVEL=INFO
LOG_DIR=./logs
