# Database Configuration
DATABASE_URL=postgresql://cctv_user:cctv_password@localhost:5432/cctv_db
DB_USER=cctv_user
DB_PASSWORD=cctv_password
DB_NAME=cctv_db
DB_HOST=localhost
DB_PORT=5432

# Redis Configuration
REDIS_URL=redis://localhost:6379

# AWS Configuration (only needed if FACE_RECOGNITION_BACKEND=aws)
# Leave empty to use free local InsightFace mode
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Application Configuration
APP_ENV=development
DEBUG=True
SECRET_KEY=your-secret-key-change-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,backend

# API Configuration
API_TITLE=CCTV Face Recognition Dashboard
API_VERSION=1.0.0
API_DESCRIPTION=Real-time face recognition and tracking system

# Security
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
CORS_ALLOW_CREDENTIALS=True

# File Upload
MAX_UPLOAD_SIZE=52428800
UPLOAD_DIR=./uploads

# Face Recognition
CONFIDENCE_THRESHOLD=0.9
MAX_FACES_PER_IMAGE=10
FACE_MATCH_THRESHOLD=0.6

# Face Recognition Backend
# local  = InsightFace ArcFace (free, self-hosted, CPU-friendly) [RECOMMENDED]
# aws    = AWS Rekognition (paid, cloud-based)
FACE_RECOGNITION_BACKEND=local

# InsightFace model (only used when FACE_RECOGNITION_BACKEND=local)
# buffalo_sc = compact ArcFace, ~80ms/frame  on CPU [DEFAULT]
# buffalo_l  = full    ArcFace, ~300ms/frame on CPU (better for GPU servers)
INSIGHTFACE_MODEL=buffalo_sc

# Crowded 1080p scenes: split wide frames into two overlapping 640px
# detector passes, then merge duplicate faces at tile boundaries.
# auto = enabled only for landscape frames at least 1280px wide
FACE_CROWD_MODE=auto
FACE_CROWD_MIN_WIDTH=1280
FACE_TILE_OVERLAP=0.15

# RTSP / OpenCV stability
# Prefer TCP for CCTV RTSP streams to reduce packet loss and H.264 macroblock
# decode errors. Override only if a camera/NVR explicitly requires UDP.
OPENCV_FFMPEG_CAPTURE_OPTIONS=rtsp_transport;tcp|timeout;5000000
OPENCV_FFMPEG_LOGLEVEL=-8
OPENCV_LOG_LEVEL=ERROR

# Alert Configuration
ALERT_RETENTION_DAYS=30

# Phase 1 Security Rules
CAMERA_OFFLINE_CHECK_INTERVAL_SECONDS=30
CAMERA_OFFLINE_RTSP_TIMEOUT_SECONDS=5
CAMERA_OFFLINE_FAIL_THRESHOLD=3
CAMERA_OFFLINE_RECOVER_THRESHOLD=2

# Logging
LOG_LEVEL=INFO
LOG_DIR=./logs
