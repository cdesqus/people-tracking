    style VIS fill:#7ED321,stroke:#5FA319,color:#fff
    style DETECT fill:#7ED321,stroke:#5FA319,color:#fff
    style ALERT fill:#7ED321,stroke:#5FA319,color:#fff
    style REPORT fill:#7ED321,stroke:#5FA319,color:#fff
    style FACE_DET fill:#BD10E0,stroke:#8A0AA8,color:#fff
    style FACE_REC fill:#BD10E0,stroke:#8A0AA8,color:#fff
    style TRACK fill:#BD10E0,stroke:#8A0AA8,color:#fff
    style CAM_STATUS fill:#BD10E0,stroke:#8A0AA8,color:#fff
    style SQL fill:#FF6B6B,stroke:#C92A2A,color:#fff
    style VECTOR fill:#FF6B6B,stroke:#C92A2A,color:#fff
    style REDIS fill:#FF6B6B,stroke:#C92A2A,color:#fff
    style S3 fill:#FF6B6B,stroke:#C92A2A,color:#fff
    style QUEUE fill:#50E3C2,stroke:#369B8B,color:#fff
    style EVENTS fill:#50E3C2,stroke:#369B8B,color:#fff
    style CCTV fill:#B8E986,stroke:#8AB846,color:#000
    style EMAIL fill:#B8E986,stroke:#8AB846,color:#000
    style SMS fill:#B8E986,stroke:#8AB846,color:#000
    style SLACK fill:#B8E986,stroke:#8AB846,color:#000