graph TB
    subgraph "Frontend Layer"
        WEB["🌐 Web Dashboard<br/>React + Tailwind"]
        MOBILE["📱 Mobile App<br/>React Native/Flutter"]
        ADMIN["⚙️ Admin Panel<br/>React"]
    end

    subgraph "API Gateway & Authentication"
        GATEWAY["API Gateway<br/>FastAPI/Express"]
        AUTH["Authentication<br/>JWT + OAuth2"]
    end

    subgraph "Core Business Logic"
        EMP["Employee<br/>Management"]
        VIS["Visitor<br/>Management"]
        DETECT["Detection<br/>Engine"]
        ALERT["Alert<br/>System"]
        REPORT["Report<br/>Generator"]
    end

    subgraph "AI/ML Processing"
        FACE_DET["Face Detection<br/>YOLOv8/RetinaFace"]
        FACE_REC["Face Recognition<br/>InsightFace/FaceNet"]
        TRACK["Object Tracking<br/>DeepSORT"]
        CAM_STATUS["Camera Status<br/>Detection"]
    end

    subgraph "Data & Storage"
        SQL["PostgreSQL<br/>Employees, Visitors,<br/>Detections, Alerts"]
        VECTOR["Vector DB<br/>pgvector<br/>Face Embeddings"]
        REDIS["Redis Cache<br/>Real-time Data,<br/>Sessions"]
        S3["Object Storage<br/>Face Images,<br/>Snapshots"]
    end

    subgraph "Message Queue & Events"
        QUEUE["Message Queue<br/>RabbitMQ/Kafka"]
        EVENTS["Event Stream<br/>Processing"]
    end

    subgraph "External Integrations"
        CCTV["📹 CCTV Cameras<br/>RTSP Stream"]
        EMAIL["📧 Email<br/>Notifications"]
        SMS["💬 SMS<br/>Alerts"]
        SLACK["💼 Slack<br/>Integration"]
    end

    subgraph "Infrastructure & Monitoring"
        DOCKER["Docker<br/>Containerization"]
        K8S["Kubernetes<br/>Orchestration"]
        MONITOR["Prometheus<br/>Grafana"]
        LOG["ELK Stack<br/>Logging"]
    end

    WEB --> GATEWAY
    MOBILE --> GATEWAY
    ADMIN --> GATEWAY

    GATEWAY --> AUTH
    AUTH --> EMP
    AUTH --> VIS
    AUTH --> DETECT
    AUTH --> ALERT
    AUTH --> REPORT

    CCTV --> FACE_DET
    CCTV --> CAM_STATUS
    FACE_DET --> FACE_REC
    FACE_REC --> TRACK
    TRACK --> DETECT
    CAM_STATUS --> ALERT

    DETECT --> QUEUE
    DETECT --> SQL
    DETECT --> VECTOR
    FACE_REC --> VECTOR

    EMP --> SQL
    VIS --> SQL
    ALERT --> QUEUE
    REPORT --> SQL

    QUEUE --> EVENTS
    EVENTS --> ALERT
    EVENTS --> REDIS

    ALERT --> EMAIL
    ALERT --> SMS
    ALERT --> SLACK

    FACE_DET --> S3
    TRACK --> S3

    GATEWAY --> REDIS
    EMP --> REDIS
    VIS --> REDIS
    DETECT --> REDIS

    DOCKER --> K8S
    K8S --> MONITOR
    K8S --> LOG

    style WEB fill:#4A90E2,stroke:#2E5C8A,color:#fff
    style MOBILE fill:#4A90E2,stroke:#2E5C8A,color:#fff
    style ADMIN fill:#4A90E2,stroke:#2E5C8A,color:#fff
